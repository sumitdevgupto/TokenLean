# Direct dependencies — HUMAN-MAINTAINED floors + license notes.
# requirements.txt is COMPILED from this file (full pinned resolve) by
# scripts/compile-requirements.sh — edit HERE, then regenerate; never edit
# requirements.txt by hand. CI and the Docker image install requirements.txt,
# so what ships is the pinned resolve, not these floors.
#
# Deliberately NOT pinned in the compiled output (see the script): torch (the
# Dockerfile preinstalls the CPU build of the version named below, which the pins
# are resolved against; a pin would drag the ~2.5 GB CUDA wheel back in), its CUDA
# runtime (nvidia-*, cuda-*, triton), and uvloop (Linux-only; pulled on Linux via
# uvicorn[standard]'s own environment marker).
litellm>=1.95.1,<2.0.0                       # MIT — pinned: floor at tested 1.95.0, cap pre-2.0 to avoid breaking changes
boto3>=1.34.0                                # Apache-2.0 — AWS Bedrock provider lane (litellm `bedrock/`); pulls in botocore
fastapi>=0.111.0                             # MIT
uvicorn[standard]>=0.30.0                    # BSD-3-Clause
httpx>=0.27.0                                # BSD-3-Clause
pyyaml>=6.0.3                               # MIT
redis>=5.0.0                                 # MIT — the async client (redis.asyncio) is part of the package; redis has no "asyncio" extra
asyncpg>=0.31.0                              # Apache-2.0
google-cloud-storage>=2.16.0                 # Apache-2.0
google-cloud-secret-manager>=2.20.0          # Apache-2.0
google-cloud-run>=0.16.1                     # Apache-2.0
langfuse>=2.7.0,<3.0.0                       # MIT
opentelemetry-sdk>=1.25.0                    # Apache-2.0
opentelemetry-exporter-otlp>=1.25.0          # Apache-2.0
tiktoken>=0.7.0                              # MIT
qdrant-client>=1.12,<1.13                    # Apache-2.0 — pinned to match Qdrant server v1.12.x (query_points/RRF API; avoids 1.18 skew)
fastembed>=0.3.0                             # Apache-2.0
sentence-transformers>=5.6.1                 # Apache-2.0
torch==2.14.0                                # Apache-2.0 AND Apache-2.0 WITH LLVM-exception AND BSD-2-Clause AND BSD-3-Clause AND BSL-1.0 AND MIT — the License-Expression of 2.14.0 (the CPU wheel too: PyTorch's own code is BSD-3-Clause, the rest is bundled third-party code); what sentence-transformers runs on: the CPU build the Dockerfile installs, at this version
prometheus-client>=0.20.0                    # Apache-2.0 AND BSD-2-Clause
instructor>=1.3.0                            # MIT
jsonschema>=4.20.0                           # MIT — G11 output JSON-schema validation (validate_output); also a transitive litellm dep, pinned here as a direct dependency

